# Anthropic API 키 (필수). `ant auth login`을 썼다면 비워둬도 됩니다.
ANTHROPIC_API_KEY=
# 요약 모델 (기본: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5
# 거절(refusal) 시 서버측 폴백: default | off
ANTHROPIC_FALLBACKS=default
# 선택: 응답 길이/생각 깊이
LLM_MAX_TOKENS=16000
LLM_EFFORT=
# 본문 최대 길이(문자)
MAX_TEXT_CHARS=40000
# Git 퍼블리시 대상
GIT_REMOTE=origin
GIT_BRANCH=main
LOG_LEVEL=INFO
